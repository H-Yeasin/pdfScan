{
  "expo": {
    "name": "pdfScan",
    "slug": "yeasin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "pdfscan",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.pdfScan",
      "infoPlist": {
        "LSSupportsOpeningDocumentsInPlace": true,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "PDF Document",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["com.adobe.pdf"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.pdfScan",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [{ "mimeType": "application/pdf" }]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [{ "scheme": "file", "host": "*", "pathPattern": ".*\\\\.pdf" }]
        },
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [{ "mimeType": "application/pdf" }]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan documents."
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to import documents."
        }
      ],
      "expo-sqlite",
      [
        "rn-mlkit-ocr",
        {
          "ocrModels": [
            "latin",
            "chinese",
            "devanagari",
            "japanese",
            "korean"
          ],
          "ocrUseBundled": true
        }
      ],
      "expo-asset",
      "react-native-pdf-jsi"
    ],
    "extra": {
      "eas": {
        "projectId": "ca74717d-56ca-4cfe-b21d-c15ffaf9a8de"
      }
    },
    "owner": "yeasindevs-team"
  }
}
