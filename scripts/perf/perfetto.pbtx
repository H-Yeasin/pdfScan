# §19 X1: what scripts/perf/trace.sh records. Open the file it pulls in https://ui.perfetto.dev
# (the trace stays in the browser; nothing is uploaded) and search "pdfscan." for the app's own
# sections (the trace vocabulary in docs/qa/performance.md §19).
#
# Threads to read: the app's main thread (input, Choreographer#doFrame), mqt_js (JavaScript),
# RenderThread, modules/pdf-native's pdf-native-pdfium / -encode / -decode threads, and
# HeapTaskDaemon (GC).
# trace.sh replaces DURATION_MS.

duration_ms: DURATION_MS

buffers {
  size_kb: 131072
  fill_policy: RING_BUFFER
}
buffers {
  size_kb: 8192
  fill_policy: RING_BUFFER
}

data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_wakeup"
      ftrace_events: "sched/sched_waking"
      ftrace_events: "sched/sched_process_exit"
      ftrace_events: "sched/sched_process_free"
      ftrace_events: "task/task_newtask"
      ftrace_events: "task/task_rename"
      # CPU speed and idle: a phone that throttles after three 20-page scans shows here.
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/cpu_idle"
      ftrace_events: "power/suspend_resume"
      ftrace_events: "thermal/thermal_temperature"
      ftrace_events: "thermal/cdev_update"
      # Low-memory kills.
      ftrace_events: "lowmemorykiller/lowmemory_kill"
      ftrace_events: "oom/oom_score_adj_update"
      ftrace_events: "ftrace/print"
      atrace_categories: "am"
      atrace_categories: "wm"
      atrace_categories: "gfx"
      atrace_categories: "view"
      atrace_categories: "input"
      atrace_categories: "dalvik"
      atrace_categories: "binder_driver"
      atrace_categories: "hal"
      atrace_categories: "res"
      atrace_categories: "disk"
      # The app's own sections: android.os.Trace from modules/pdf-native (src/utils/trace.ts), and
      # what React Native, Fabric and Hermes write themselves.
      atrace_apps: "com.yeasin.pdfscan"
      compact_sched {
        enabled: true
      }
    }
  }
}

# Each process's memory every second (RSS, swap; the PSS column of meminfo.sh is more exact).
data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 1
    process_stats_config {
      scan_all_processes_on_start: true
      proc_stats_poll_ms: 1000
    }
  }
}

# The phone's free memory every second.
data_sources {
  config {
    name: "linux.sys_stats"
    target_buffer: 1
    sys_stats_config {
      meminfo_period_ms: 1000
      meminfo_counters: MEMINFO_MEM_AVAILABLE
      meminfo_counters: MEMINFO_MEM_FREE
      meminfo_counters: MEMINFO_SWAP_FREE
    }
  }
}

# Each frame's deadline and whether it was missed, per app (Android 12 and newer).
data_sources {
  config {
    name: "android.surfaceflinger.frametimeline"
  }
}

data_sources {
  config {
    name: "android.packages_list"
    target_buffer: 1
  }
}

# The system's own lines about the app (starts, "Fully drawn", kills, ANRs). Only these tags: the
# app's own log lines can name a document, and a trace leaves the phone.
data_sources {
  config {
    name: "android.log"
    target_buffer: 1
    android_log_config {
      min_prio: PRIO_INFO
      filter_tags: "ActivityManager"
      filter_tags: "ActivityTaskManager"
      filter_tags: "lowmemorykiller"
      filter_tags: "lmkd"
    }
  }
}
